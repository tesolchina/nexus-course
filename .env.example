# Copy to .env and fill in. The server reads these at startup.

# Port the server listens on (default 3000 locally).
PORT=3000

# OpenAI-compatible API. Talks to ANY OpenAI-compatible /chat/completions endpoint.
# Option A: plain OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Which course.yaml to serve (relative to the project root or absolute path).
# COURSE_FILE=courses/genai-101.yaml
# COURSE_FILE=courses/ati-271b.yaml

# Teacher password for classroom session management.
# Default: "demo1234" (change this in production!)
# TEACHER_PASSWORD=your-secure-password

# Data directory for persistent JSON stores (sessions, cache, live sessions).
# Default: <project-root>/data
# For Railway, mount a volume and set: DATA_DIR=/data
# DATA_DIR=

# Remote course URL (optional — overrides local COURSE_FILE on startup).
# If unset, local COURSE_FILE is used. Also settable via teacher dashboard.
# COURSE_URL=